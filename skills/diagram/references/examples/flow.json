{
  "schema_version": 1,
  "diagram_type": "flow",
  "meta": {
    "title": "Checkout — order flow",
    "lang": "en",
    "description": "Happy path left to right; the declined branch sits below the payment step and returns to the form through the free row."
  },
  "layout": { "cols": 5 },
  "mainPath": ["cart", "checkout", "fraud", "pay", "confirm"],
  "nodes": [
    { "id": "cart", "type": "frontend", "label": "Cart", "row": 0, "col": 0 },
    { "id": "checkout", "type": "frontend", "label": "Checkout form", "row": 0, "col": 1 },
    { "id": "fraud", "type": "security", "label": "Fraud check", "row": 0, "col": 2 },
    { "id": "pay", "type": "external", "label": "Payment provider", "row": 0, "col": 3 },
    { "id": "confirm", "type": "backend", "label": "Confirm order", "row": 0, "col": 4 },
    { "id": "declined", "type": "backend", "label": "Payment declined", "row": 1, "col": 3 },
    { "id": "notify", "type": "external", "label": "Email", "row": 1, "col": 4 }
  ],
  "edges": [
    { "from": "cart", "to": "checkout", "label": "checkout" },
    { "from": "checkout", "to": "fraud", "label": "submit" },
    { "from": "fraud", "to": "pay", "label": "charge" },
    { "from": "pay", "to": "confirm", "label": "approved" },
    { "from": "pay", "to": "declined", "label": "declined" },
    { "from": "declined", "to": "checkout", "label": "retry", "variant": "return", "toSide": "bottom" },
    { "from": "confirm", "to": "notify", "label": "receipt", "variant": "dashed" }
  ]
}
